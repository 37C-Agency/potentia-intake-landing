---
interface Props {
  question: string;
  open?: boolean;
}
const { question, open = false } = Astro.props;
---

<details
  class="reveal group border-b border-navy/10 last:border-0 transition-colors"
  open={open}
>
  <summary class="flex items-start justify-between gap-6 py-6 cursor-pointer list-none select-none">
    <span class="text-lg md:text-xl font-display font-semibold text-navy leading-snug">{question}</span>
    <span class="shrink-0 h-6 w-6 grid place-items-center text-fresh-blue transition-transform duration-200 ease-out group-open:rotate-45 mt-1" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="10" y1="3" x2="10" y2="17" />
        <line x1="3" y1="10" x2="17" y2="10" />
      </svg>
    </span>
  </summary>
  <div class="pb-6 pr-12 text-navy/80 leading-relaxed max-w-prose">
    <slot />
  </div>
</details>
