---
import { PRICING_INTAKE } from '@/lib/site-content-intake';
---

<section class="section-pad bg-bone">
  <div class="container-page grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start">

    <div class="lg:col-span-5 reveal">
      <h2 class="font-display text-h2 text-navy leading-tight">{PRICING_INTAKE.headline}</h2>
      <p class="text-[15.5px] sm:text-[17px] text-text-muted leading-relaxed mt-4">{PRICING_INTAKE.body}</p>

      <ul class="mt-6 space-y-3">
        {PRICING_INTAKE.refusals.map((line) => (
          <li class="flex items-start gap-3 text-navy text-[14.5px] sm:text-[15.5px] leading-snug font-medium">
            <svg class="text-fresh-blue mt-1 shrink-0" width="13" height="13" viewBox="0 0 18 18" fill="currentColor" aria-hidden="true">
              <path d="M9 1.5 L15 5 V13 L9 16.5 L3 13 V5 Z" />
            </svg>
            <span>{line}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="lg:col-span-7 reveal" style="transition-delay: 100ms">
      <div class="rounded-2xl border border-border-faint bg-mist shadow-card overflow-hidden">
        {PRICING_INTAKE.rows.map((row, i) => (
          <div class={`flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-6 sm:px-8 py-5 sm:py-6 ${i > 0 ? 'border-t border-border-faint' : ''} ${row.highlight ? 'bg-fresh-blue/[0.07]' : ''}`}>
            <div class="min-w-0">
              <p class={`font-display text-[1.05rem] sm:text-[1.15rem] font-semibold leading-snug tracking-[-0.01em] ${row.highlight ? 'text-navy' : 'text-navy/85'}`}>{row.label}</p>
              <p class="text-[13px] sm:text-[14px] text-text-muted leading-snug mt-1">{row.note}</p>
            </div>
            <p class={`font-display text-[1.35rem] sm:text-[1.6rem] font-bold leading-none tabular-nums whitespace-nowrap ${row.highlight ? 'text-fresh-blue' : 'text-navy/70'}`}>{row.value}</p>
          </div>
        ))}
      </div>

      <div class="mt-5 flex justify-center lg:justify-start">
        <a href="#hero-form" class="btn-primary inline-flex items-center justify-center gap-2 text-[15px] md:text-[17px]" data-cta="intake-pricing">
          Start with the intake session
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="9" x2="14" y2="9" />
            <polyline points="9 4 14 9 9 14" />
          </svg>
        </a>
      </div>
    </div>

  </div>
</section>
