---
import { storyblokEditable } from '@storyblok/astro';
import { ABOUT } from '@/lib/site-content';

interface Props { blok?: any }
const { blok } = Astro.props;
const headline = blok?.headline ?? ABOUT.headline;
const paragraphs = blok?.paragraphs ?? ABOUT.paragraphs;
const credentials = blok?.credentials ?? ABOUT.credentials;
const team = blok?.team ?? ABOUT.team;
const teamPhoto = blok?.team_photo ?? ABOUT.teamPhoto;
const editable = blok ? storyblokEditable(blok) : {};
---

<section {...editable} id="about" class="section-pad bg-mist">
  <div class="container-wide grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
    <!-- LEFT — sticky photo column that stays visible while text scrolls -->
    <div class="reveal lg:col-span-6">
      <div class="lg:sticky lg:top-24">
        <div class="aspect-[2/1] bg-sand rounded-2xl overflow-hidden ring-1 ring-navy/10">
          <img
            src={teamPhoto}
            alt="The Potentia Clinics specialist team — eight clinical psychologists, psychiatrists, and dietitians at the Dubai Science Park clinic"
            width="2450"
            height="1196"
            loading="lazy"
            decoding="async"
            class="object-cover h-full w-full transition-transform duration-700 ease-out hover:scale-[1.03]"
          />
        </div>
        <!-- Small caption pill for visual ballast -->
        <p class="hidden lg:flex mt-4 items-center justify-center gap-2 text-[12px] text-text-muted">
          <svg width="13" height="13" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 1.5 C5.5 1.5 3 4 3 7.5 C3 11 9 16.5 9 16.5 S15 11 15 7.5 C15 4 12.5 1.5 9 1.5 Z" />
            <circle cx="9" cy="7.5" r="2" />
          </svg>
          The Potentia Clinics team. Dubai Science Park.
        </p>
      </div>
    </div>

    <!-- RIGHT — text, tightened so it doesn't run double the image height -->
    <div class="reveal reveal-delay-1 lg:col-span-6">
      <h2 class="font-display text-h2 text-navy" style="text-wrap: balance;">{headline}</h2>

      <div class="mt-6 space-y-4 text-navy/85 leading-relaxed text-base sm:text-[17px]">
        {paragraphs.map((p: string) => <p set:html={p} />)}
      </div>

      <div class="mt-7">
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5">
          {team.map((m: { name: string; title: string }) => (
            <li class="flex items-start gap-2.5 text-navy text-[14px] sm:text-[14.5px] leading-snug">
              <svg class="text-fresh-blue mt-1 shrink-0" width="12" height="12" viewBox="0 0 18 18" fill="currentColor" aria-hidden="true">
                <path d="M9 1.5 L15 5 V13 L9 16.5 L3 13 V5 Z" />
              </svg>
              <span>
                <span class="font-semibold">{m.name}</span>
                <span class="block text-[12.5px] sm:text-[13px] text-text-muted">{m.title}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-7">
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2">
          {credentials.map((c: string) => (
            <li class="flex items-start gap-2.5 text-navy text-[14px] sm:text-[14.5px]">
              <svg class="text-fresh-blue mt-1 shrink-0" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="3 8 6.5 11.5 13 5" />
              </svg>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>
