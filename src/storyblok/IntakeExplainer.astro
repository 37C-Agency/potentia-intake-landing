---
import { EXPLAINER } from '@/lib/site-content-intake';
---

<section class="section-pad bg-mist relative isolate overflow-hidden">
  <div
    class="absolute inset-x-0 top-0 h-72 -z-10 opacity-60 pointer-events-none"
    style="background: radial-gradient(ellipse at top, rgba(184,201,71,0.18) 0%, rgba(184,201,71,0) 70%);"
    aria-hidden="true"
  ></div>

  <div class="container-page">
    <h2 class="reveal font-display text-h2 text-navy text-center mb-10 sm:mb-12">{EXPLAINER.headline}</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
      {EXPLAINER.beats.map((beat) => (
        <div class="rounded-2xl bg-bone border border-border-faint shadow-card p-6 md:p-7 flex gap-4 sm:gap-5">
          <span class="inline-flex items-center justify-center h-11 w-11 sm:h-12 sm:w-12 rounded-xl bg-fresh-blue/10 text-fresh-blue shrink-0">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {beat.icon === 'listen' && (
                <>
                  <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
                  <path d="M8 12h.01" />
                  <path d="M12 12h.01" />
                  <path d="M16 12h.01" />
                </>
              )}
              {beat.icon === 'question' && (
                <>
                  <circle cx="12" cy="12" r="9" />
                  <path d="M9.2 9.3a3 3 0 0 1 5.8 1c0 2-3 3-3 3" />
                  <path d="M12 17h.01" />
                </>
              )}
              {beat.icon === 'read' && (
                <>
                  <path d="M3 5.5A2.5 2.5 0 0 1 5.5 3H10a2 2 0 0 1 2 2v14a1.5 1.5 0 0 0-1.5-1.5H5.5A2.5 2.5 0 0 1 3 15Z" />
                  <path d="M21 5.5A2.5 2.5 0 0 0 18.5 3H14a2 2 0 0 0-2 2v14a1.5 1.5 0 0 1 1.5-1.5h5A2.5 2.5 0 0 0 21 15Z" />
                </>
              )}
              {beat.icon === 'decide' && (
                <>
                  <path d="M6 3v12" />
                  <circle cx="6" cy="18" r="3" />
                  <circle cx="18" cy="6" r="3" />
                  <path d="M18 9v1a5 5 0 0 1-5 5h-1" />
                </>
              )}
            </svg>
          </span>
          <div>
            <p class="font-display text-[1.15rem] sm:text-[1.25rem] font-semibold text-navy leading-snug tracking-[-0.01em]">{beat.title}</p>
            <p class="text-[14.5px] sm:text-[15.5px] text-text-muted leading-relaxed mt-2">{beat.body}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="reveal mt-5 sm:mt-6 rounded-2xl bg-navy on-dark p-6 md:p-8">
      <p class="font-display text-[1.3rem] sm:text-[1.5rem] font-semibold text-white leading-snug tracking-[-0.01em] mb-5">{EXPLAINER.takeawayHeadline}</p>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
        {EXPLAINER.takeaways.map((item) => (
          <li class="flex items-start gap-3 text-white/85 text-[14.5px] sm:text-[15.5px] leading-snug">
            <span class="inline-flex items-center justify-center h-6 w-6 rounded-full bg-fresh-green text-navy shrink-0 mt-0.5">
              <svg width="13" height="13" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="3 9 7 13 15 5" />
              </svg>
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
