---
import { storyblokEditable } from '@storyblok/astro';
import { COST_COMPARISON } from '@/lib/site-content';

interface Props { blok?: any }
const { blok } = Astro.props;
const headline = blok?.headline ?? COST_COMPARISON.headline;
const intro = blok?.intro ?? COST_COMPARISON.intro;
const editable = blok ? storyblokEditable(blok) : {};

// 3-column comparison: weakest → middle → ours (drives the eye to the right column)
const columns = [
  {
    tone: 'negative' as const,
    title: 'Wing it alone',
    sub: 'Books, apps, podcasts',
    items: [
      'No clinical assessment',
      'No accountability',
      'No medical coordination',
      'Patches the surface, not the cause',
      'Stuck on the same loop for years',
    ],
  },
  {
    tone: 'middle' as const,
    title: 'Generic therapy app',
    sub: 'A partial solution',
    items: [
      'Different therapist each week',
      'Mostly text, often rushed',
      'No integrated psychiatry',
      'Hard to build a real plan',
      'Limited support if things escalate',
    ],
  },
  {
    tone: 'positive' as const,
    title: 'Potentia Clinics',
    sub: 'Premium private clinical care',
    items: [
      'Same DHA-licensed psychologist',
      'Private 50-minute sessions',
      'Full clinical assessment up front',
      'Psychology, psychiatry, and nutrition under one roof',
      'In person at our Dubai Science Park clinic',
    ],
    highlight: true,
  },
];
---

<section {...editable} class="section-pad bg-sand">
  <div class="container-page">
    <div class="reveal max-w-3xl mb-12">
      <p class="eyebrow text-text-muted mb-3">The math</p>
      <h2 class="font-display text-h2 text-navy mb-6">{headline}</h2>
      <p class="text-body-lg text-navy/80 leading-relaxed max-w-prose">{intro}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 md:gap-6">
      {columns.map((col, idx) => {
        const isPositive = col.tone === 'positive';
        const isMiddle = col.tone === 'middle';
        const isNegative = col.tone === 'negative';
        const cardClass = isPositive
          ? 'bg-bone border-fresh-green ring-2 ring-fresh-green/40 shadow-[0_24px_60px_-12px_rgba(74,103,85,0.45)] lg:scale-[1.07] lg:-translate-y-3 z-10'
          : isMiddle
            ? 'bg-bone/85 border-navy/10'
            : 'bg-bone/60 border-navy/10 opacity-90';
        const animClass = idx === 0 ? 'animate-slide-left' : idx === 2 ? 'animate-slide-right' : 'animate-fade-up';
        const delayStyle = `animation-delay: ${idx * 120}ms`;
        return (
          <div
            class={`reveal-comparison rounded-2xl border-[1.5px] ${cardClass} p-7 md:p-8 transition-transform`}
            style={delayStyle}
            data-anim={animClass}
          >
            {isPositive && (
              <span class="inline-flex items-center gap-1.5 bg-fresh-green text-navy text-[11.5px] font-bold uppercase tracking-[0.14em] px-3.5 py-1.5 rounded-full mb-4 shadow-[0_4px_12px_-4px_rgba(184,201,71,0.6)]">
                <svg width="11" height="11" viewBox="0 0 18 18" fill="currentColor" aria-hidden="true">
                  <path d="M9 1.5 L15 5 V13 L9 16.5 L3 13 V5 Z" />
                </svg>
                Recommended
              </span>
            )}
            <p class={`font-display font-semibold mb-1 ${isPositive ? 'text-navy text-2xl md:text-3xl' : isNegative ? 'text-text-muted text-xl md:text-2xl' : 'text-navy/80 text-xl md:text-2xl'}`}>
              {col.title}
            </p>
            <p class={`text-sm mb-6 ${isPositive ? 'text-fresh-blue font-semibold' : 'text-text-muted'}`}>
              {col.sub}
            </p>
            <ul class="space-y-3.5">
              {col.items.map((item) => (
                <li class="flex items-start gap-3">
                  {isPositive ? (
                    <span class="inline-flex items-center justify-center h-6 w-6 rounded-full bg-fresh-green text-navy mt-0.5 shrink-0 ring-1 ring-fresh-green/40">
                      <svg width="14" height="14" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="3 9 7 13 15 5" />
                      </svg>
                    </span>
                  ) : (
                    <span class="inline-flex items-center justify-center h-6 w-6 rounded-full bg-[#E8554B]/12 text-[#C44438] mt-0.5 shrink-0 ring-1 ring-[#E8554B]/25">
                      <svg width="12" height="12" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="5" x2="13" y2="13" />
                        <line x1="13" y1="5" x2="5" y2="13" />
                      </svg>
                    </span>
                  )}
                  <span class={`text-[15px] leading-snug ${isPositive ? 'text-navy font-semibold' : 'text-navy/70'} ${isNegative ? 'line-through decoration-1 decoration-text-muted/40' : ''}`}>
                    {item}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>

    <div class="reveal mt-12 text-center">
      <a href="#hero-form" class="btn-primary" data-cta="cost-comparison">
        Request a first consultation
      </a>
      <p class="mt-3 text-xs text-text-muted">Confidential. Reply within 24 hours.</p>
    </div>
  </div>
</section>

<style>
  .reveal-comparison {
    opacity: 0;
    transform: translateY(20px);
  }
  .reveal-comparison.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1), transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal-comparison { transition: opacity 100ms linear; transform: none; }
  }
</style>

<script>
  // Custom observer for comparison cards (independent of generic .reveal so we can stagger)
  function initComparisonReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '-100px 0px', threshold: 0.1 }
    );
    document.querySelectorAll('.reveal-comparison').forEach((el) => observer.observe(el));
  }
  document.addEventListener('astro:page-load', initComparisonReveal);
  initComparisonReveal();
</script>
