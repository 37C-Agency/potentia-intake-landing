---
import { storyblokEditable } from '@storyblok/astro';
import { FAQ } from '@/lib/site-content';
import AccordionItem from '@/components/ui/AccordionItem.astro';

interface Props { blok?: any }
const { blok } = Astro.props;
const headline = blok?.headline ?? FAQ.headline;
const items: { q: string; a: string }[] = blok?.items ?? FAQ.items;
const editable = blok ? storyblokEditable(blok) : {};

// FAQ schema is also injected globally in Layout.astro — kept here too for component-level editor preview
---

<section {...editable} id="faq" class="section-pad bg-bone">
  <div class="container-narrow">
    <div class="reveal text-center mb-12">
      <h2 class="font-display text-h2 text-navy">{headline}</h2>
    </div>

    <div class="border-t border-navy/10">
      {items.map((it, i) => (
        <AccordionItem question={it.q} open={false}>
          <p>{it.a}</p>
        </AccordionItem>
      ))}
    </div>
  </div>
</section>
