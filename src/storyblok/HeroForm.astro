---
import { storyblokEditable } from '@storyblok/astro';
import CostEstimateForm from '@/components/forms/CostEstimateForm.astro';

interface Props { blok?: any }
const { blok } = Astro.props;
const editable = blok ? storyblokEditable(blok) : {};
---

<!--
  Dedicated form section (lives directly under TrustStrip).
  Owns the #hero-form anchor — every CTA on the page scrolls here.
-->
<section
  {...editable}
  id="hero-form"
  class="bg-bone scroll-mt-20 relative overflow-hidden"
  aria-label="Book a private consultation"
>
  <img
    src="/images/form-bg-breath.png"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover opacity-50 pointer-events-none select-none"
    style="mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);"
  />

  <div class="container-page py-16 md:py-20 relative z-10">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-8 reveal">
        <p class="eyebrow text-fresh-green mb-3">Start here</p>
        <h2 class="font-display text-navy leading-tight font-semibold whitespace-nowrap text-[clamp(1.05rem,4.6vw,2.25rem)]">
          Get matched to the right psychologist
        </h2>
      </div>

      <div class="reveal reveal-delay-1">
        <CostEstimateForm />
      </div>
    </div>
  </div>
</section>
