---
import { storyblokEditable } from '@storyblok/astro';
import { PROCESS } from '@/lib/site-content';

interface Props { blok?: any }
const { blok } = Astro.props;
const headline = blok?.headline ?? PROCESS.headline;
const steps = blok?.steps ?? PROCESS.steps;
const editable = blok ? storyblokEditable(blok) : {};
---

<section {...editable} class="section-pad bg-navy on-dark relative overflow-hidden">
  <img
    src="/images/process-eeg.png"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover opacity-50 pointer-events-none select-none"
    style="mix-blend-mode: screen; mask-image: radial-gradient(ellipse 75% 55% at center, black 25%, transparent 80%); -webkit-mask-image: radial-gradient(ellipse 75% 55% at center, black 25%, transparent 80%);"
  />

  <div class="container-page relative z-10">
    <div class="reveal max-w-3xl mb-14">
      <p class="eyebrow text-fresh-green mb-3">How it works</p>
      <h2 class="font-display text-h2 text-white">{headline}</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {steps.map((s: any, idx: number) => (
        <article class={`reveal reveal-delay-${idx + 1} card-on-dark flex flex-col`}>
          <span class="inline-flex items-center justify-center font-display font-bold text-navy tabular text-3xl md:text-4xl leading-none mb-6 h-14 w-14 md:h-16 md:w-16 rounded-2xl bg-fresh-green ring-1 ring-fresh-green/60">
            {String(s.n).padStart(2, '0')}
          </span>
          <h3 class="font-display text-xl md:text-2xl text-white font-bold mb-3 leading-tight">
            {s.title}
          </h3>
          <p class="text-white/75 leading-relaxed flex-1 text-[15px]">{s.body}</p>
          <p class="mt-6 text-xs text-fresh-green uppercase tracking-[0.18em] font-semibold">
            {s.time}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
