---
import Layout from '@/layouts/Layout.astro';
import TopBar from '@/storyblok/TopBar.astro';
import Hero from '@/storyblok/Hero.astro';
import HeroForm from '@/storyblok/HeroForm.astro';
import TrustStrip from '@/storyblok/TrustStrip.astro';
import FourSituations from '@/storyblok/FourSituations.astro';
import Benefits from '@/storyblok/Benefits.astro';
import FilterProof from '@/storyblok/FilterProof.astro';
import Process from '@/storyblok/Process.astro';
import CostComparison from '@/storyblok/CostComparison.astro';
import SocialProof from '@/storyblok/SocialProof.astro';
import About from '@/storyblok/About.astro';
import Faq from '@/storyblok/Faq.astro';
import FinalCta from '@/storyblok/FinalCta.astro';
import Footer from '@/storyblok/Footer.astro';
---

<Layout>
  <TopBar />
  <main>
    <Hero />
    <HeroForm />
    <TrustStrip />
    <FourSituations />
    <Benefits />
    <FilterProof />
    <Process />
    <CostComparison />
    <SocialProof />
    <About />
    <Faq />
    <FinalCta />
